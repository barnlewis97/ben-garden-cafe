---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import { teamContent } from '../../data/content';

const content = teamContent.vi;
---

<Layout title={content.title}>
	<Navbar activePage="team" lang="vi" />

	<main class="content-container">
		<header class="hero-small">
			<h1>{content.heading}</h1>
			<p>{content.intro}</p>
		</header>

		<section class="team-grid">
			{content.members.map(member => (
				<div class="team-card">
					<Image 
						src={member.image} 
						alt={member.name} 
						width={200} 
						height={200} 
						class="team-avatar"
					/>
					<h3>{member.name}</h3>
					<span class="role">{member.role}</span>
					<p>{member.bio}</p>
				</div>
			))}
		</section>
	</main>
	<Footer lang="vi" />
</Layout>

<style>
	.content-container {
		max-width: 900px;
		margin: 2rem auto;
		padding: 0 1rem;
		line-height: 1.6;
	}
	.hero-small {
		text-align: center;
		margin-bottom: 3rem;
	}
	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 2rem;
	}
	.team-card {
		border: 1px solid #ead6be;
		border-radius: 8px;
		padding: 1.5rem;
		text-align: center;
		background: #e3e2bf;
	}
	.team-avatar {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		object-fit: cover;
		margin: 0 auto 1rem auto;
		display: block;
	}
	.role {
		display: inline-block;
		color: #888;
		font-size: 0.9rem;
		margin-bottom: 0.5rem;
	}
</style>