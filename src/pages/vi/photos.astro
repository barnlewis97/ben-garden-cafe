---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { photosContent, siteInfo } from '../../data/content';

const content = photosContent.vi;
---

<Layout title={content.title}>
	<Navbar activePage="photos" lang="vi" />

	<main class="content-container">
		<header class="hero-small">
			<h1>{content.heading}</h1>
			<p>{content.intro}</p>
		</header>

		<section class="gallery-grid">
			{content.items.map(item => (
				<figure class="gallery-item">
					<img src={item.src} alt={item.alt} loading="lazy" />
					<figcaption>{item.alt}</figcaption>
				</figure>
			))}
		</section>

		<p class="attribution">
			Hình ảnh từ <a href={siteInfo.workawayUrl} target="_blank" rel="noopener noreferrer">Workaway</a> và <a href={siteInfo.facebookUrl} target="_blank" rel="noopener noreferrer">BẾN Garden trên Facebook</a>.
		</p>
	</main>
	<Footer lang="vi" />
</Layout>

<style>
	.content-container {
		max-width: 900px;
		margin: 2rem auto;
		padding: 0 1rem;
		line-height: 1.6;
	}
	.hero-small {
		text-align: center;
		margin-bottom: 3rem;
	}
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 1.5rem;
	}
	.gallery-item {
		margin: 0;
		background-color: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
	}
	.gallery-item img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.gallery-item figcaption {
		padding: 0.75rem 0.9rem;
		color: #475569;
		font-size: 0.9rem;
	}
	.attribution {
		margin-top: 1.5rem;
		color: #64748b;
		font-size: 0.85rem;
	}
</style>