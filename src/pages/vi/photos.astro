---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { photosContent } from '../../data/content';

const content = photosContent.vi;
---

<Layout title={content.title}>
	<Navbar activePage="photos" lang="vi" />

	<main class="content-container">
		<header class="hero-small">
			<h1>{content.heading}</h1>
			<p>{content.intro}</p>
		</header>

		<section class="gallery-grid">
			{content.items.map(item => <div class="gallery-item">📷 {item}</div>)}
		</section>
	</main>
	<Footer lang="vi" />
</Layout>

<style>
	.content-container {
		max-width: 900px;
		margin: 2rem auto;
		padding: 0 1rem;
		line-height: 1.6;
	}
	.hero-small {
		text-align: center;
		margin-bottom: 3rem;
	}
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 1.5rem;
	}
	.gallery-item {
		background-color: #f0f0f0;
		border: 2px dashed #ccc;
		border-radius: 8px;
		height: 200px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #666;
		font-size: 0.95rem;
	}
</style>