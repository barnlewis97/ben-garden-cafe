---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import benImg from '../../assets/ben welcome.jpeg';
import { homeContent } from '../../data/content';

const content = homeContent.vi;
---

<Layout title={content.title}>
	<Navbar activePage="home" lang="vi" />

	<main class="content-container">
		<header class="hero-small">
			<h1>{content.heading}</h1>
		</header>

		<section class="story-section">
			<div class="text-block">
				<h2>{content.storyHeading}</h2>
				{content.storyParagraphs.map(paragraph => <p>{paragraph}</p>)}
			</div>
			
			<Image 
				src={benImg} 
				alt={content.imageAlt}
				width={500} 
				height={350} 
				class="story-image"
			/>
		</section>
	</main>
	<Footer lang="vi" />
</Layout>

<style>
	.content-container {
		max-width: 900px;
		margin: 2rem auto;
		padding: 0 1rem;
		line-height: 1.6;
	}
	.hero-small {
		text-align: center;
		margin-bottom: 3rem;
	}
	.story-section {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: center;
	}
	.story-image {
		width: 100%;
		height: auto;
		border-radius: 8px;
		object-fit: cover;
	}
	@media (max-width: 600px) {
		.story-section {
			grid-template-columns: 1fr;
		}
	}
</style>