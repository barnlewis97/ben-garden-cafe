---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import benImg from '../../assets/ben welcome.jpeg';
---



<Layout title="Bến Garden Cafe | Home">
	<Navbar activePage="home"/>

	<main class="content-container">
		<header class="hero-small">
			<h1>Welcome to Bến Garden</h1>
		</header>

		<section class="story-section">
			<div class="text-block">
				<h2>Our Story</h2>
				<p>
					Founded with a vision to create a peaceful sanctuary for locals and visitors alike, our cafe brings together craft coffee, warm hospitality, and a commitment to giving back.
				</p>
				<p>
					Whether you are stopping by for your morning brew, learning about our community programs, or relaxing in our garden space, we are delighted to welcome you.
				</p>
			</div>
			
			<Image 
				src={benImg} 
				alt="Bến Garden Cafe exterior and garden" 
				width={500} 
				height={350} 
				class="story-image"
			/>
		</section>
	</main>
	<Footer lang="en" />
</Layout>

<style>
	.content-container {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem 1rem;
		line-height: 1.6;
	}
	.hero-small {
		text-align: center;
		margin-bottom: 3rem;
	}
	.story-section {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: center;
	}
	.story-image {
		width: 100%;
		height: auto;
		border-radius: 8px;
		object-fit: cover;
	}
	@media (max-width: 600px) {
		.story-section {
			grid-template-columns: 1fr;
		}
	}
</style>