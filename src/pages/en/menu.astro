---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { menuContent } from '../../data/content';

const content = menuContent.en;
---

<Layout title={content.title}>
	<Navbar activePage="menu" lang="en" />

	<main class="content-container">
		<header class="hero-small">
			<h1>{content.heading}</h1>
			<p class="tagline">{content.tagline}</p>
			<p>{content.intro}</p>
		</header>
		
		<div class="menu-grid">
			{content.sections.map(section => (
				<section class="menu-card">
					<h2>{section.category}</h2>
					{section.subtitle && <p class="subtitle">{section.subtitle}</p>}
					<ul class="item-list">
						{section.items.map(item => (
							<li class="menu-item">
								<span class="item-name">{item.name}</span>
								<span class="dots"></span>
								<span class="item-price">{item.price}</span>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	</main>

	<Footer lang="en" />
</Layout>

<style>
	.tagline {
		font-style: italic;
		color: #05a517;
		font-size: 1.05rem;
		margin-bottom: 0.5rem;
		text-align: center !important;
	}
	.content-container {
		max-width: 1000px;
		margin: 2rem auto;
		padding: 0 1rem;
	}
	.hero-small {
		text-align: center;
		margin-bottom: 2.5rem;
	}
	.hero-small h1 {
		font-size: 2.2rem;
		color: #05a517;
		margin-bottom: 0.5rem;
	}
	.menu-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}
	.menu-card {
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
		padding: 1.5rem;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
	}
	.menu-card h2 {
		font-size: 1.3rem;
		color: #1e293b;
		border-bottom: 2px solid #05a517;
		padding-bottom: 0.4rem;
		margin-bottom: 0.8rem;
	}
	.subtitle {
		font-style: italic;
		font-size: 0.85rem;
		color: #64748b;
		margin-bottom: 1rem;
	}
	.item-list {
		list-style: none;
		padding: 0;
	}
	.menu-item {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 0.6rem;
		font-size: 0.95rem;
	}
	.item-name {
		font-weight: 500;
		color: #334155;
	}
	.dots {
		flex: 1;
		border-bottom: 1px dotted #cbd5e1;
		margin: 0 0.5rem;
	}
	.item-price {
		font-weight: 700;
		color: #05a517;
	}
</style>