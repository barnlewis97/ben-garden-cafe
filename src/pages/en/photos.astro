---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { photosContent, siteInfo } from '../../data/content';

const content = photosContent.en;
---

<Layout title={content.title}>
	<Navbar activePage="photos" />

	<main class="content-container">
		<header class="hero-small">
			<h1>{content.heading}</h1>
			<p>{content.intro}</p>
		</header>

		<section class="gallery-grid">
			{content.items.map(item => (
				<figure class="gallery-item">
					<img src={item.src} alt={item.alt} loading="lazy" />
					<figcaption>{item.alt}</figcaption>
				</figure>
			))}
		</section>

		<p class="attribution">
			Photos from <a href={siteInfo.workawayUrl} target="_blank" rel="noopener noreferrer">Workaway</a> and <a href={siteInfo.facebookUrl} target="_blank" rel="noopener noreferrer">BẾN Garden on Facebook</a>.
		</p>
	</main>
	<Footer lang="en" />
</Layout>

<style>
	.navbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.5rem 2rem;
		background-color: #f8f5f0;
		border-bottom: 1px solid #e2dcd5;
	}
	.logo {
		font-weight: bold;
		font-size: 1.25rem;
		color: #2c3e50;
		text-decoration: none;
	}
	.nav-links a {
		margin-left: 1.5rem;
		text-decoration: none;
		color: #555;
	}
	.nav-links a.active {
		font-weight: bold;
		color: #2c3e50;
	}
	.content-container {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem 1rem;
		font-family: sans-serif;
		color: #333;
		line-height: 1.6;
	}
	.hero-small {
		text-align: center;
		margin-bottom: 3rem;
	}
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 1.5rem;
	}
	.gallery-item {
		margin: 0;
		background-color: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
	}
	.gallery-item img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.gallery-item figcaption {
		padding: 0.75rem 0.9rem;
		color: #475569;
		font-size: 0.9rem;
	}
	.attribution {
		margin-top: 1.5rem;
		color: #64748b;
		font-size: 0.85rem;
	}
</style>