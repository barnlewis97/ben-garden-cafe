---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { missionContent } from '../../data/content';

const content = missionContent.en;
---

<Layout title={content.title}>
    <Navbar activePage="mission" />

	<main class="content-container">
		<header class="hero-small">
			<h1>{content.heading}</h1>
			<p>{content.intro}</p>
		</header>

		<section class="mission-grid">
			{content.cards.map(card => (
				<div class="card">
					<div class="icon">{card.icon}</div>
					<h3>{card.heading}</h3>
					<p>{card.body}</p>
				</div>
			))}
		</section>
	</main>
	<Footer lang="en" />
</Layout>

<style>
	.navbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.5rem 2rem;
		background-color: #f8f5f0;
		border-bottom: 1px solid #e2dcd5;
	}
	.logo {
		font-weight: bold;
		font-size: 1.25rem;
		color: #2c3e50;
		text-decoration: none;
	}
	.nav-links a {
		margin-left: 1.5rem;
		text-decoration: none;
		color: #555;
	}
	.nav-links a.active {
		font-weight: bold;
		color: #2c3e50;
	}
	.content-container {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem 1rem;
		font-family: sans-serif;
		color: #333;
		line-height: 1.6;
	}
	.hero-small {
		text-align: center;
		margin-bottom: 3rem;
	}
	.mission-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}
	.card {
		background: #fafafa;
		border: 1px solid #eee;
		border-radius: 8px;
		padding: 1.5rem;
		text-align: center;
	}
	.icon {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}
</style>